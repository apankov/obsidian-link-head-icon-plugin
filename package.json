{
  "name": "link-head-icon",
  "version": "0.1.0",
  "description": "Obsidian plugin that shows a site icon ahead of external links",
  "main": "main.js",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "icons": "node scripts/generate-icons.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin"
  ],
  "author": "Andrey Pankov",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "^1.14.4",
    "simple-icons": "^16.37.0",
    "simple-icons-legacy": "npm:simple-icons@^9.21.0",
    "svgo": "^3.3.5",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
